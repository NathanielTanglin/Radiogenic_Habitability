# Host star parameters
sName star
saModules stellar

dMass 2.2e30
dAge 5e7

# STELLAR Parameters
sStellarModel baraffe
bHaltEndBaraffeGrid 0 # Ends the simulation when the grid edge is reached.
dSatXUVTime 1e7
dXUVBeta 1.24
dSatXUVFrac 0.8012e-4 # Saturation level of the XUV luminosity.
dSurfMagField 0.0002314

saOutputOrder Time Age -Luminosity -LXUVStellar -Radius Temperature LXUVFrac