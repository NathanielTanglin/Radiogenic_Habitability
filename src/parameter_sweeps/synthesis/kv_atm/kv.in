# Host star parameters
sName star
saModules stellar

dMass 1.72e30
dAge 5e7

# STELLAR Parameters
sStellarModel baraffe
bHaltEndBaraffeGrid 1 # Ends the simulation when the grid edge is reached.
dSatXUVTime 1e8
dXUVBeta 1.221
dSatXUVFrac 1.203e-3 # Saturation level of the XUV luminosity.
dSurfMagField 0.0008491 # Tesla (8.76 Gauss)

saOutputOrder Time Age -Luminosity -LXUVStellar -Radius Temperature LXUVFrac